APP_NAME=MMI2 Schedule System
DATABASE_URL=sqlite:///./mmi2.db
JWT_SECRET=change-this-in-production
ACCESS_TOKEN_MINUTES=43200

# Used only to create the first owner when admin_users is empty.
ADMIN_EMAIL=owner@example.com
# Compatibility fallback for installations upgrading from older versions.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_TOKEN_MINUTES=480
